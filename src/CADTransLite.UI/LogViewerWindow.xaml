<Window x:Class="CADTransLite.UI.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志浏览" Height="620" Width="960" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="日志文件：" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbFiles" Width="340" SelectionChanged="CmbFiles_SelectionChanged"/>
            <Button x:Name="BtnCopyAll" Content="一键复制" Margin="10,0,0,0" Padding="12,3" MinWidth="90"
                    Click="BtnCopyAll_Click"/>
            <Button x:Name="BtnCopySel" Content="复制选中" Margin="6,0,0,0" Padding="12,3" MinWidth="90"
                    Click="BtnCopySel_Click"/>
            <Button x:Name="BtnRefresh" Content="刷新" Margin="6,0,0,0" Padding="12,3" MinWidth="70"
                    Click="BtnRefresh_Click"/>
            <TextBlock x:Name="TxtInfo" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>
        <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 TextWrapping="NoWrap"/>
    </DockPanel>
</Window>
